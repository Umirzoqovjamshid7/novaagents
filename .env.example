ADMIN_PASSWORD=CHANGE_THIS_TO_LONG_RANDOM_PASSWORD
AGENT_WORKSPACE=/opt/agent-engineer-real/workspace
# For isolated self-test ONLY. Remove to use Codex:
# MOCK_CODEX=1
# Shared backend API key used by Telegram adapter / n8n (generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))')
AGENT_API_KEY=REPLACE_WITH_LONG_RANDOM_TOKEN
# Optional read-only key for dashboards/monitoring integrations
AGENT_READONLY_API_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_TOKEN
AGENT_API_URL=http://127.0.0.1:8765
# Maximum number of queued/running tasks (protects the in-process worker)
AGENT_MAX_QUEUE_SIZE=100
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# numeric private user IDs, separated by commas; do not use group ids
TELEGRAM_ALLOWED_IDS=123456789
